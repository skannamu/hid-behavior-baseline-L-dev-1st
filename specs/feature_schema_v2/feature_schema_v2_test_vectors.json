    },
    {
      "name": "three_key_overlap_union_is_bounded",
      "events": [
        {
          "t": 0,
          "device": 0,
          "make": 30,
          "ext": 0,
          "vkey": 65,
          "action": "down"
        },
        {
          "t": 20000000,
          "device": 0,
          "make": 48,
          "ext": 0,
          "vkey": 66,
          "action": "down"
        },
        {
          "t": 40000000,
          "device": 0,
          "make": 46,
          "ext": 0,
          "vkey": 67,
          "action": "down"
        },
        {
          "t": 60000000,
          "device": 0,
          "make": 48,
          "ext": 0,
          "vkey": 66,
          "action": "up"
        },
        {
          "t": 80000000,
          "device": 0,
          "make": 46,
          "ext": 0,
          "vkey": 67,
          "action": "up"
        },
        {
          "t": 100000000,
          "device": 0,
          "make": 30,
          "ext": 0,
          "vkey": 65,
          "action": "up"
        }
      ],
      "expected": {
        "state_for_vkey_65": {
          "hold_time_s": 0.1,
          "overlap_union_duration_s": 0.06,
          "overlap_fraction": 0.6
        },
        "global_assertions": [
          "0 <= overlap_fraction <= 1 for every state"
        ]
      }
    },
    {
